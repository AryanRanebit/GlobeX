{
  "name": "globex-ai-backend",
  "version": "1.0.0",
  "description": "GlobeX AI \u2014 AI-powered Export Growth Platform for Indian Businesses",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts --ext ts,json --ignore node_modules --ignore dist",
    "build": "tsc",
    "start": "node dist/server.js",
    "index-docs": "tsx src/ai/indexDocuments.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "seed:comtrade": "tsx prisma/seed_comtrade.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "test": "vitest run",
    "seed:mirror": "tsx prisma/seed_mirror_imports.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "chromadb": "^3.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.14",
    "prisma": "^5.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
